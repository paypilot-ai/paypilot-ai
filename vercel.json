{
  "version": 2,
  "rewrites": [
    {
      "source": "/partners",
      "destination": "/partners.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*\\.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        }
      ]
    }
  ],
  "functions": {
    "api/ai-call.js": {
      "maxDuration": 30
    },
    "api/search-company.js": {
      "maxDuration": 30
    }
  }
}
